  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
    background: #080d13;
    color: #d8e6f3;
}

QLabel {
    color: #d8e6f3;
}

QFrame#heroHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #101b27, stop:0.58 #0c121a, stop:1 #13141b);
    border: 1px solid #21364a;
    border-radius: 8px;
}

QLabel#brandLogo {
    background: #eef4fa;
    border: 1px solid #2b506d;
    border-radius: 8px;
    padding: 4px;
}

QFrame#controlPanel,
QFrame#previewPanel,
QFrame#statusPanel {
    background: #101822;
    border: 1px solid #23394d;
    border-radius: 8px;
}

QFrame#statusTile,
QFrame#statusTile2,
QFrame#statusTile3,
QFrame#statusTileAudio,
QFrame#statusTile4 {
    background: #0c141d;
    border: 1px solid #203347;
    border-radius: 6px;
}

QLabel#appTitle {
    color: #f4f8fb;
    font-size: 22px;
    font-weight: 700;
}

QLabel#appSubtitle,
QLabel#panelHint,
QLabel#previewHint,
QLabel#metricLabel,
QLabel#metricLabel2,
QLabel#metricLabel3,
QLabel#metricLabelAudio,
QLabel#metricLabel4 {
    color: #8fa6ba;
}

QLabel#sectionTitle,
QLabel#sectionTitleActions,
QLabel#sectionTitlePreview,
QLabel#sectionTitleStatus {
    color: #f0f6fb;
    font-size: 14px;
    font-weight: 700;
}

QLabel#labelDevice,
QLabel#labelBackend,
QLabel#labelPixelFormat,
QLabel#labelBitDepth {
    color: #9db3c7;
    font-weight: 600;
}

QLabel#statusBadge {
    color: #9ce8ff;
    background: #0c2534;
    border: 1px solid #1f91c7;
    border-radius: 6px;
    padding: 7px 12px;
    font-weight: 700;
}

QLabel#previewTitle {
    color: #f6fbff;
    font-size: 24px;
    font-weight: 700;
}

QLabel#metricValue,
QLabel#metricValue2,
QLabel#metricValue3,
QLabel#metricValueAudio,
QLabel#metricValue4 {
    color: #f1f8ff;
    font-size: 16px;
    font-weight: 700;
}

QLabel#labelinfo1 {
    color: #a9bfd2;
    background: #0b121a;
    border: 1px solid #1d2e3f;
    border-radius: 6px;
    padding: 9px 12px;
}

QComboBox {
    background: #0a1119;
    color: #e2edf7;
    border: 1px solid #2a4358;
    border-radius: 5px;
    padding: 7px 32px 7px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #2aa7ff;
}

QPushButton {
    background: #162536;
    color: #ecf6ff;
    border: 1px solid #34516a;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 700;
}

QPushButton:hover {
    background: #1f3449;
    border-color: #2aa7ff;
}

QPushButton:pressed {
    background: #0f6da7;
    border-color: #1e75a5;
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton#btnStart {
    background: #0b73b8;
    border-color: #2aa7ff;
}

QPushButton#btnStart:pressed {
    background: #07598f;
    border-color: #166f9e;
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton#btnRecord {
    background: #84262f;
    border-color: #ee4d4d;
}

QPushButton#btnRecord:pressed {
    background: #651b23;
    border-color: #a92b37;
    padding-top: 9px;
    padding-bottom: 7px;
}

QPushButton#btnStop {
    background: #333a43;
    border-color: #5b6875;
}

QPushButton#btnStop:pressed {
    background: #222831;
    border-color: #3f4a55;
    padding-top: 9px;
    padding-bottom: 7px;
}</string>
